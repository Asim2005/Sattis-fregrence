<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Pass Authorization header through (many shared hosts strip it)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Route /api/* to the PHP backend via PATH_INFO
    # e.g. /api/auth/login -> backend/index.php with PATH_INFO=/auth/login
    RewriteRule ^api/(.*)$ backend/index.php/$1 [QSA,L]

    # Serve real files and directories as-is (assets, uploads, favicon, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # SPA fallback: everything else serves index.html (React Router handles it)
    RewriteRule ^ index.html [L]
</IfModule>
